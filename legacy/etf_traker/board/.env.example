# board/.env 로 복사해서 값을 채운다. .env 는 .gitignore 에 걸려 있다.
# 실제 값은 여기 적지 마라. 이 파일은 커밋된다.
#
# GitHub Actions 로 돌릴 때는 이 파일이 아니라 레포 Settings -> Secrets and
# variables -> Actions 에 같은 이름으로 넣는다.

# 한국투자증권 KIS Developers — 투자자별 수급, 실시간 시세
# https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
# KIS_ACCOUNT: 계좌번호 8자리-2자리. 시세 조회만 쓸 거면 비워도 된다
# ([KBJ P1] 줄 끝 주석을 윗줄로 옮겼다 — 공개 안전 검사가 주석을 값으로 읽는다)
KIS_ACCOUNT=
KIS_ENV=real              # real | vts(모의투자)

# KRX 오픈API — 업종분류, 전 종목 시세
# http://openapi.krx.co.kr
KRX_API_KEY=

# DART OpenAPI — 공시, 기업개황(업종코드)
# https://opendart.fss.or.kr
DART_API_KEY=

# 네이버 검색 API — 뉴스 (ID 와 SECRET 둘 다 필요하다)
# https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 — 주식시세정보 (선택. KRX 오픈API 가 되면 없어도 된다)
DATAGO_KEY=

# Anthropic — 서술 생성
ANTHROPIC_API_KEY=

# 발송
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 인박스 — X 게시물을 공유받을 대화방 (선택, 쉼표 구분). 비우면 TELEGRAM_CHAT_ID 를 읽는다
TRIGGER_INBOX_CHAT_IDS=
NOTION_TOKEN=
NOTION_DATABASE_ID=
