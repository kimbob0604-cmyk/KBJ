# 복사해서 .env 로 쓴다. .env 는 git 에 올리지 않는다.
# GitHub Actions 에서는 같은 이름을 Repository secrets 에 등록한다.

# KIS 시세 전용 실전 앱키 (REST·웹소켓 수집)
KIS_APP_KEY=
KIS_APP_SECRET=
# real | vts (모의). 시세 수집은 반드시 real
KIS_ENV=real

# KIS 모의 앱키 — 주간 모의 주문 검증 전용 (Phase 8)
KIS_DEMO_APP_KEY=
KIS_DEMO_APP_SECRET=
KIS_DEMO_ACCOUNT=

# KRX Open API
KRX_API_KEY=
# (선택) scheduler KRX 전일 적재의 하루 호출 상한. 기본 200 — 바꿀 때만 주석을 푼다
# KRX_DAILY_CALL_CAP=200

# 텔레그램 (Phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis (토큰 캐시·레이트리미터·pub/sub). docker compose 안에서는 compose 가 redis://redis:6379/0
# 으로 덮어쓴다 — 여기 값은 호스트에서 probe 를 돌릴 때만 쓴다 (예: redis://localhost:6379/0)
REDIS_URL=

# PostgreSQL + TimescaleDB. db 컨테이너 비밀번호와 서비스 접속 문자열 — 둘의 비밀번호를 같게.
# compose 안에서 호스트는 db: postgresql://gexlab:<비밀번호>@db:5432/gexlab
# 비밀번호는 URL 에 그대로 넣을 수 있는 문자만(영숫자 — openssl rand -hex 24 등)
POSTGRES_PASSWORD=
DATABASE_URL=

# (선택) DB 장애 동안 쓰기 묶음을 쌓는 로컬 디스크 큐 상한(서비스 하나, MB). 기본 1024 —
# 바꿀 때만 주석을 풀어 숫자를 넣는다(빈 값은 설정 오류)
# SPOOL_MAX_MB=1024

# 실전 주문 스위치. Phase 9 전까지 false 고정
LIVE_TRADING=false
