# KBJ 환경변수 이름표 — 복사해서 .env 로 쓴다(.env 는 git 에 올리지 않는다).
# 값은 여기에 적지 않는다. 이름·용도·발급처·등급은 docs/secrets.md.
# 빈 값은 '설정 안 함'(기본값)으로 읽는다(kbj/config/settings.py). 비밀이 아닌 튜닝값은 config/*.yaml.

# ── KIS — 발급은 services.auth 만(ADR 0001 U1). 앱키·시크릿은 KIS REST 를 부르는 프로세스에도 넣는다
#    (모든 요청 헤더에 필요 — ADR 0004). 그 프로세스들은 토큰을 Redis 에서 읽기만 한다 ─────────────
KBJ_KIS_APP_KEY=
KBJ_KIS_APP_SECRET=
# real | vts (기본 real)
KBJ_KIS_ENV=

# ── 시세·공시·통계 API ──────────────────────────────────────────────────────────────
KBJ_KRX_API_KEY=
KBJ_DART_API_KEY=
# 공공데이터포털 — 관세청 수출입·금투협 종합통계 같은 키
KBJ_DATAGO_KEY=
KBJ_KOSIS_KEY=
KBJ_ECOS_KEY=
KBJ_FRED_KEY=
KBJ_FINNHUB_KEY=
# 네이버 검색 API(로그인 전용, 대체 후 삭제 후보 — ADR 0001 U4)
KBJ_NAVER_SEARCH_ID=
KBJ_NAVER_SEARCH_SECRET=
# LLM 은 요약·문장화에만(절대 규칙 3)
KBJ_ANTHROPIC_API_KEY=

# ── 텔레그램 — services.notifier 만 읽는다(ADR 0001 U1) ─────────────────────────────────
KBJ_TELEGRAM_BOT_TOKEN=
KBJ_TELEGRAM_CHAT_ID=
# 쉼표 구분
KBJ_TELEGRAM_INBOX_CHAT_IDS=
KBJ_TELEGRAM_WEBHOOK_SECRET=
# true 일 때만 발송(기본 false)
KBJ_NOTIFY_ENABLED=

# ── 저장소 — docker-compose.yml 이 KBJ_POSTGRES_PASSWORD·KBJ_REDIS_PASSWORD 를 요구한다 ───────
# 비밀번호는 URL 에 그대로 넣을 수 있는 영숫자로(예: openssl rand -hex 24). 접속 문자열의 비밀번호와 같게
KBJ_POSTGRES_PASSWORD=
KBJ_REDIS_PASSWORD=
KBJ_DATABASE_URL=
KBJ_REDIS_URL=
# 실행 산출물 루트(기본 state)·DB 장애 동안 디스크 큐(기본 state/spool, 상한 MB 기본 1024)
KBJ_DATA_DIR=
KBJ_SPOOL_DIR=
KBJ_SPOOL_MAX_MB=

# ── API·운영 ────────────────────────────────────────────────────────────────────────
# 기본 127.0.0.1 / 8000
KBJ_API_HOST=
KBJ_API_PORT=
# 텔레그램 웹훅 주소의 앞부분(운영 VM 도메인). 주소는 레포·문서에 적지 않는다
KBJ_PUBLIC_BASE_URL=
KBJ_GIT_COMMIT=
KBJ_HEALTHCHECK_URL=
KBJ_PROBE_OUT_DIR=
KBJ_TEST_TIMESCALE_IMAGE=

# ── 로그인 웹(P3) — 사용자 1명. 기본 사용자·비밀번호는 없다(둘 중 하나라도 비면 로그인 503) ─────
KBJ_WEB_USER=
# python -m kbj.services.api hash-password 가 stdout 에 낸 scrypt$… 값(비밀번호 원문은 어디에도 두지 않는다)
# 값에 '$' 가 들어 있어 작은따옴표로 감싼다 — KBJ_WEB_PASSWORD_HASH='scrypt$…' (따옴표가 없으면 compose 가 $ 를 변수로 치환해 값이 깨진다)
KBJ_WEB_PASSWORD_HASH=
# 세션 고정 만료(시간, 기본 12)
KBJ_WEB_SESSION_TTL_H=
# 기본 true(__Host- 쿠키, TLS 프록시 뒤). false 는 KBJ_API_HOST 가 루프백일 때만(개발)
KBJ_WEB_COOKIE_SECURE=
# 로그인 SPA 빌드 폴더(기본 web/dist-login)
KBJ_WEB_DIST_DIR=

# ── 공개 내보내기(P3) — pub_* 만 읽는 kbj_public_export 구성원 역할의 접속 문자열 ──────────────
KBJ_PUBLIC_EXPORT_DATABASE_URL=
# public-data 브랜치 푸시·Pages 디스패치 — 사용자 승인 전엔 비워 둔다(기본 false)
KBJ_PUBLIC_PUSH_ENABLED=
KBJ_PUBLIC_DEPLOY_KEY_PATH=
KBJ_GITHUB_DISPATCH_TOKEN=

# ── 프로세스·설정 파일 ────────────────────────────────────────────────────────────────
# 이 프로세스의 서비스 이름(compose 가 서비스마다 넣는다: auth·scheduler·notifier …, 소문자).
# KIS 발급자는 auth 일 때만 만들어진다(ADR 0004). 비우면 없음(시험·스크립트)
KBJ_SERVICE=
# config/*.yaml 폴더(기본 config — 상대 경로는 레포 루트 기준, 설치 이미지에서는 절대 경로)
KBJ_CONFIG_DIR=

# ── 실전 주문 스위치 — 기본 false. 사용자 승인 전엔 바꾸지 않는다(절대 규칙 6) ────────────────
KBJ_LIVE_TRADING=
